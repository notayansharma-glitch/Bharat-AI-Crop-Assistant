<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F8"
    tools:context=".MainActivity">

    <!-- Bottom Navigation Bar (Fixed at Bottom) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnTabAi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:text="@string/tab_ai"
            android:textColor="#2E7D32"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <Button
            android:id="@+id/btnTabAbout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:text="@string/tab_about"
            android:textColor="#555555"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Content Area Container (Above Bottom Nav Bar) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar">

        <!-- TAB 1: AI Diagnosis Screen -->
        <ScrollView
            android:id="@+id/layoutAiContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <!-- Top Header Bar -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/btnLanguage"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/title_app"
                        android:textColor="#1B5E20"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnLanguage"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:backgroundTint="#614385"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/btn_lang_toggle"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Image Preview Frame (Zero padding for clean square edges) -->
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/image_border"
                    android:padding="0dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Tomato leaf photo preview" />

                <!-- Primary Action Button: Take Photo -->
                <Button
                    android:id="@+id/btnCapture"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#fbe355"
                    android:fontFamily="sans-serif"
                    android:text="@string/btn_take_photo"
                    android:textColor="#1B5E20"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Secondary Action Button: Upload Gallery -->
                <Button
                    android:id="@+id/btnGallery"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="18dp"
                    android:backgroundTint="#379d74"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/btn_upload_gallery"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Diagnosis Result Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/result_card_bg"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:backgroundTint="#e6ffea"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tvResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/tv_result_default"
                        android:textAlignment="center"
                        android:textColor="#1B5E20"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Discreet Toggle Link for Confidence Details -->
                    <TextView
                        android:id="@+id/btnConfidenceDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/btn_view_confidence"
                        android:textColor="#1976D2"
                        android:textSize="14sp"
                        android:padding="4dp"
                        android:visibility="gone" />

                    <!-- Hidden Expandable Confidence Value -->
                    <TextView
                        android:id="@+id/tvConfidenceValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAlignment="center"
                        android:textColor="#555555"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Dedicated LLM Expert Advice Card Container (Soft Light Yellow Tint #FFFBE6) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/advice_card_bg"
                    android:backgroundTint="#FFFBE6"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvAdviceHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/title_expert_advice"
                        android:textColor="#1B5E20"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- LLM Thinking / Progress Indicator State -->
                    <LinearLayout
                        android:id="@+id/llThinkingState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:id="@+id/progressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginBottom="8dp"
                            android:indeterminate="true"
                            android:indeterminateTint="#2E7D32" />

                        <TextView
                            android:id="@+id/tvThinkingStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/thinking_status"
                            android:textColor="#2E7D32"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Scrollable Expert Advice Content -->
                    <TextView
                        android:id="@+id/tvRecommendation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/tv_recommendation_default"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: About App Screen -->
        <ScrollView
            android:id="@+id/layoutAboutContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone"
            android:background="#F5F7F8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/about_title"
                    android:textColor="#1B5E20"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/about_subtitle"
                    android:textColor="#555555"
                    android:textSize="15sp"
                    android:textAlignment="center" />

                <!-- Creators Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/result_card_bg"
                    android:backgroundTint="#FFFFFF"
                    android:padding="20dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/about_creators_header"
                        android:textColor="#1B5E20"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/about_creators_names"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:lineSpacingExtra="6dp" />

                </LinearLayout>

                <!-- Project & Challenge Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/result_card_bg"
                    android:backgroundTint="#FFFFFF"
                    android:padding="20dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/about_project_header"
                        android:textColor="#1B5E20"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/about_project_desc"
                        android:textColor="#333333"
                        android:textSize="15sp"
                        android:lineSpacingExtra="6dp" />

                </LinearLayout>

                <!-- Footer Date & Heart -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/about_footer_date"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:textAlignment="center" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</RelativeLayout>
